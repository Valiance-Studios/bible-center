rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Everything not matched below is denied, so each new collection must opt in with its own rules.

    // A verified email on the allowlist. It must be verified: anyone can register a password account
    // with someone else's address, and it stays unverified until they prove they own it.
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    function isAllowedOwner(uid) {
      return isAllowed() && request.auth.uid == uid;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Keep in sync with ROLES in packages/core/src/roles.ts. An entry with no role is a member.
    function myRole() {
      return get(/databases/$(database)/documents/allowedUsers/$(myEmail())).data.get('role', 'member');
    }

    // Handles reports and the topics people start.
    function isReviewer() {
      return isAllowed() && myRole() in ['reviewer', 'admin'];
    }

    // Manages the allowlist and roles.
    function isAdmin() {
      return isAllowed() && myRole() == 'admin';
    }

    // Matches normalizeEmail and isEmailAddress in packages/core/src/roles.ts.
    function isEmailKey(email) {
      return email.size() <= 254
        && email == email.lower()
        && email.matches('[^@\\s/]+@[^@\\s/]+[.][^@\\s/]+');
    }

    function isValidAllowedUser(data) {
      return data.keys().hasOnly(['role', 'updatedBy', 'updatedAt'])
        && data.keys().hasAll(['role', 'updatedBy', 'updatedAt'])
        && data.role in ['member', 'reviewer', 'admin']
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    // The allowlist, keyed by lowercase email, with each person's role. Users may check themselves. Admins manage
    // everyone else in the app, but never their own entry, so the last admin cannot lock everyone out.
    // The first admin is set in the Firebase console.
    match /allowedUsers/{email} {
      allow get: if request.auth != null
        && request.auth.token.email_verified == true
        && myEmail() == email;

      allow read: if isAdmin();

      allow create, update: if isAdmin()
        && email != myEmail()
        && isEmailKey(email)
        && isValidAllowedUser(request.resource.data);

      allow delete: if isAdmin() && email != myEmail();
    }

    // Keep the translation ids in sync with TRANSLATIONS in apps/web/src/bible/translations.ts.
    function isValidUserSettings(data) {
      return data.keys().hasOnly(['translationId'])
        && data.translationId in ['bsb', 'kjv'];
    }

    // Keep in sync with Annotation and NOTE_MAX_LENGTH in packages/core/src/annotations.ts.
    // A span stays within one chapter, whose id begins both of its verse ids.
    function isValidAnnotation(data) {
      return data.keys().hasOnly(['type', 'chapterId', 'startVerse', 'endVerse', 'text', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['type', 'chapterId', 'startVerse', 'endVerse', 'createdAt', 'updatedAt'])
        && data.type in ['highlight', 'bookmark', 'note']
        && data.chapterId is string
        && data.chapterId.matches('[0-9]{5}')
        && data.startVerse is string
        && data.startVerse.matches('[0-9]{8}')
        && data.endVerse is string
        && data.endVerse.matches('[0-9]{8}')
        && data.startVerse[0:5] == data.chapterId
        && data.endVerse[0:5] == data.chapterId
        && data.startVerse <= data.endVerse
        && data.updatedAt == request.time
        && (data.type == 'note'
          ? data.text is string && data.text.trim().size() > 0 && data.text.size() <= 2000
          : !('text' in data));
    }

    // Each user's own settings and annotations. Nobody can read or change another user's.
    match /users/{uid} {
      allow get: if isAllowedOwner(uid);

      allow create, update: if isAllowedOwner(uid)
        && isValidUserSettings(request.resource.data);

      match /annotations/{annotationId} {
        allow read, delete: if isAllowedOwner(uid);

        allow create: if isAllowedOwner(uid)
          && isValidAnnotation(request.resource.data)
          && request.resource.data.createdAt == request.time;

        // Only a note's words can change. Moving or retyping an annotation means replacing it.
        allow update: if isAllowedOwner(uid)
          && resource.data.type == 'note'
          && isValidAnnotation(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']);
      }

      // The verses someone is memorizing, keyed like a topic's verses. Keep in sync with MemoryVerse and
      // MEMORY_STATUSES in packages/core/src/memorize.ts. Only the status and when it was last practiced change.
      match /memoryVerses/{key} {
        allow read, delete: if isAllowedOwner(uid);

        allow create: if isAllowedOwner(uid)
          && request.resource.data.keys().hasOnly(['startVerse', 'endVerse', 'status', 'createdAt', 'practicedAt'])
          && request.resource.data.keys().hasAll(['startVerse', 'endVerse', 'status', 'createdAt', 'practicedAt'])
          && isVerseId(request.resource.data.startVerse)
          && isVerseId(request.resource.data.endVerse)
          && request.resource.data.startVerse <= request.resource.data.endVerse
          && request.resource.data.startVerse[0:2] == request.resource.data.endVerse[0:2]
          && key == verseKeyOf(request.resource.data)
          && request.resource.data.status == 'learning'
          && request.resource.data.createdAt == request.time
          && request.resource.data.practicedAt == request.time;

        allow update: if isAllowedOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'practicedAt'])
          && request.resource.data.status in ['learning', 'memorized']
          && request.resource.data.practicedAt == request.time;
      }
    }

    // The verse of the day an admin chose for a date, keyed `YYYY-MM-DD`. A date without one gets the automatic
    // list's pick, so choosing automatically deletes it. Anyone can read a date, but not list them.
    // Keep in sync with DailyVerse and isDateKey in packages/core/src/dailyVerses.ts.
    match /dailyVerses/{date} {
      allow get: if true;

      allow create, update: if isAdmin()
        && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['startVerse', 'endVerse', 'setBy', 'setAt'])
        && request.resource.data.keys().hasAll(['startVerse', 'endVerse', 'setBy', 'setAt'])
        && isVerseId(request.resource.data.startVerse)
        && isVerseId(request.resource.data.endVerse)
        && request.resource.data.startVerse <= request.resource.data.endVerse
        && request.resource.data.startVerse[0:2] == request.resource.data.endVerse[0:2]
        && request.resource.data.setBy == request.auth.uid
        && request.resource.data.setAt == request.time;

      allow delete: if isAdmin();
    }

    // Topics. Keep in sync with packages/core/src/topics.ts and apps/web/src/firebase/topics.ts.
    // OpenBible's topics are static files; these documents hold Bible Center's own votes, and the topics people start.

    // Matches topicSlug: lowercase letters and digits in hyphen-separated runs.
    function isTopicSlug(slug) {
      return slug is string && slug.size() <= 80 && slug.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    // Matches normalizeTopicName, and names the topic whose slug it is.
    function isTopicNameFor(name, slug) {
      return name is string
        && name.size() > 0 && name.size() <= 80
        && name == name.trim().lower()
        && !name.matches('.*\\s\\s.*')
        && name.replace('[^a-z0-9]+', '-').replace('^-+|-+$', '') == slug;
    }

    function isVerseId(id) {
      return id is string && id.matches('[0-9]{8}');
    }

    // Matches topicVerseKey.
    function verseKeyOf(data) {
      return data.startVerse == data.endVerse ? data.startVerse : data.startVerse + '-' + data.endVerse;
    }

    function voteOf(slug, key) {
      return /databases/$(database)/documents/topics/$(slug)/verses/$(key)/votes/$(request.auth.uid);
    }

    function verseOf(slug, key) {
      return /databases/$(database)/documents/topics/$(slug)/verses/$(key);
    }

    function removedOf(slug, key) {
      return /databases/$(database)/documents/topics/$(slug)/removed/$(key);
    }

    function isRejectedTopic(slug) {
      return exists(/databases/$(database)/documents/topics/$(slug))
        && get(/databases/$(database)/documents/topics/$(slug)).data.status == 'rejected';
    }

    // Matches topicVerseKey.
    function isVerseKey(key) {
      return key is string && key.matches('[0-9]{8}(-[0-9]{8})?');
    }

    // A topic someone started. It works by link while pending, and is listed once a reviewer approves it.
    // A rejected topic is hidden, and nobody can add verses to it.
    match /topics/{slug} {
      allow get: if true;

      allow list: if resource.data.status == 'approved' || isReviewer();

      // Keep the decisions in sync with TopicDecision in packages/core/src/review.ts.
      allow update: if isReviewer()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;

      allow create: if isAllowed()
        && isTopicSlug(slug)
        && request.resource.data.keys().hasOnly(['name', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'status', 'createdBy', 'createdAt'])
        && isTopicNameFor(request.resource.data.name, slug)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // A verse or passage on a topic, with its Bible Center upvotes. The count only ever moves by one,
      // and only in the same write as the signed-in user's own vote appearing or disappearing.
      match /verses/{key} {
        allow read: if true;

        allow create: if isAllowed()
          && isTopicSlug(slug)
          && request.resource.data.keys().hasOnly(['startVerse', 'endVerse', 'upvotes', 'createdBy', 'createdAt'])
          && request.resource.data.keys().hasAll(['startVerse', 'endVerse', 'upvotes', 'createdBy', 'createdAt'])
          && isVerseId(request.resource.data.startVerse)
          && isVerseId(request.resource.data.endVerse)
          && request.resource.data.startVerse <= request.resource.data.endVerse
          && key == verseKeyOf(request.resource.data)
          && request.resource.data.upvotes == 1
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && !isRejectedTopic(slug)
          && !exists(removedOf(slug, key))
          && !exists(voteOf(slug, key))
          && existsAfter(voteOf(slug, key));

        allow update: if isAllowed()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
          && (
            (request.resource.data.upvotes == resource.data.upvotes + 1
              && !exists(voteOf(slug, key))
              && existsAfter(voteOf(slug, key)))
            || (request.resource.data.upvotes == resource.data.upvotes - 1
              && exists(voteOf(slug, key))
              && !existsAfter(voteOf(slug, key)))
          );

        // One per user, keyed by their id. Its verse's count must move with it.
        match /votes/{voterId} {
          allow create: if isAllowed()
            && voterId == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'topic', 'createdAt'])
            && request.resource.data.keys().hasAll(['uid', 'topic', 'createdAt'])
            && request.resource.data.uid == voterId
            && request.resource.data.topic == slug
            && request.resource.data.createdAt == request.time
            && getAfter(verseOf(slug, key)).data.upvotes
              == (exists(verseOf(slug, key)) ? get(verseOf(slug, key)).data.upvotes + 1 : 1);

          allow delete: if isAllowed()
            && voterId == request.auth.uid
            && exists(verseOf(slug, key))
            && getAfter(verseOf(slug, key)).data.upvotes == get(verseOf(slug, key)).data.upvotes - 1;
        }
      }

      // A verse or passage a reviewer took off the topic, keyed like its verse. It hides OpenBible's verses too.
      match /removed/{key} {
        allow read: if true;

        allow create: if isReviewer()
          && isVerseKey(key)
          && request.resource.data.keys().hasOnly(['removedBy', 'removedAt'])
          && request.resource.data.keys().hasAll(['removedBy', 'removedAt'])
          && request.resource.data.removedBy == request.auth.uid
          && request.resource.data.removedAt == request.time;
      }
    }

    // A user's own votes, found across topics' verses with one query on `uid` and `topic`.
    match /{path=**}/votes/{voterId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Reports wait for a reviewer, and only reviewers can read them. They do not change the ranking.
    // Keep the reasons and limit in sync with REPORT_REASONS and REPORT_DETAILS_MAX_LENGTH in packages/core/src/topics.ts.
    match /reports/{reportId} {
      allow create: if isAllowed()
        && request.resource.data.keys().hasOnly(['topic', 'verseKey', 'reason', 'details', 'reportedBy', 'createdAt', 'status'])
        && request.resource.data.keys().hasAll(['topic', 'verseKey', 'reason', 'reportedBy', 'createdAt', 'status'])
        && isTopicSlug(request.resource.data.topic)
        && request.resource.data.verseKey is string
        && request.resource.data.verseKey.matches('[0-9]{8}(-[0-9]{8})?')
        && request.resource.data.reason in ['fit', 'reference', 'other']
        && (!('details' in request.resource.data)
          || (request.resource.data.details is string && request.resource.data.details.size() <= 500))
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open';

      allow read: if isReviewer();

      // A reviewer closes a report by keeping the verse, or by removing it from the topic in the same write.
      // Keep the outcomes in sync with ReportOutcome in packages/core/src/review.ts.
      allow update: if isReviewer()
        && resource.data.status == 'open'
        && request.resource.data.status in ['removed', 'kept']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt'])
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time
        && (request.resource.data.status == 'kept'
          || existsAfter(removedOf(resource.data.topic, resource.data.verseKey)));
    }
  }
}
